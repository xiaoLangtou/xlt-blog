{
  "name": "art-design-pro",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.8.0"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "vite build --mode production",
    "type-check": "vue-tsc --noEmit",
    "serve": "vite preview",
    "lint": "oxlint --vue-plugin",
    "lint:fix": "oxlint --vue-plugin --fix",
    "fix": "pnpm run lint:fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:format": "oxfmt",
    "lint:stylelint": "stylelint  \"**/*.{css,scss,vue}\" --fix",
    "lint:lint-staged": "lint-staged",
    "prepare": "husky",
    "commit": "git-cz",
    "clean:dev": "tsx scripts/clean-dev.ts"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "oxlint --vue-plugin --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{cjs,json,jsonc}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.vue": [
      "oxlint --vue-plugin --fix --no-error-on-unmatched-pattern",
      "stylelint --fix --allow-empty-input",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{html,htm}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{scss,css,less}": [
      "stylelint --fix --allow-empty-input",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{md,mdx}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{yaml,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@domternal/core": "^0.15.0",
    "@domternal/extension-block-controls": "^0.15.0",
    "@domternal/extension-code-block-lowlight": "^0.15.0",
    "@domternal/extension-details": "catalog:",
    "@domternal/extension-image": "catalog:",
    "@domternal/extension-table": "^0.15.0",
    "@domternal/theme": "^0.15.0",
    "@domternal/vue": "^0.15.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.0",
    "@lucide/vue": "^1.17.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/vue-query": "^5.100.14",
    "@tanstack/vue-table": "^8.21.3",
    "@tiptap/extension-code-block-lowlight": "^3.30.1",
    "@tiptap/extension-find-and-replace": "catalog:",
    "@tiptap/extension-highlight": "^3.30.1",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-task-item": "^3.30.1",
    "@tiptap/extension-task-list": "^3.30.1",
    "@tiptap/extension-text-align": "^3.30.1",
    "@tiptap/extension-underline": "^3.30.1",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "^3.30.1",
    "@tiptap/suggestion": "^3.30.1",
    "@tiptap/vue-3": "^3.30.1",
    "@vue/reactivity": "^3.5.21",
    "@vueuse/core": "^13.9.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "next",
    "@xlt-blog/shared": "workspace:*",
    "axios": "^1.12.2",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.13",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.2",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.10.0",
    "jit-viewer": "catalog:",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.0",
    "md-editor-v3": "catalog:",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "ohash": "^2.0.11",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.3.0",
    "prettier": "catalog:",
    "qrcode.vue": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tiptap-markdown": "^0.9.0",
    "vue": "^3.5.21",
    "vue-draggable-plus": "^0.6.0",
    "vue-files-preview": "catalog:",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.5.1",
    "xgplayer": "^3.0.20",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@iconify-json/lucide": "^1.2.109",
    "@tailwindcss/typography": "catalog:",
    "@tanstack/vue-query-devtools": "^5.91.0",
    "@types/node": "^24.0.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.0.5",
    "commitizen": "^4.3.0",
    "cz-git": "^1.11.1",
    "husky": "^9.1.5",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.81.0",
    "stylelint": "^16.20.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^4.6.0",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^36.0.1",
    "terser": "^5.36.0",
    "tsx": "^4.20.3",
    "typescript": "~5.6.3",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-element-plus": "^0.10.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^7.7.6",
    "vue-demi": "^0.14.9",
    "vue-img-cutter": "^3.0.5",
    "vue-tsc": "~2.1.6"
  }
}
