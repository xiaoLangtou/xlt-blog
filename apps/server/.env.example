# 服务端口
PORT=3000

# MySQL 连接（与 docker-compose.yml 保持一致）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=xlt_blog
DB_USER=xlt_blog
DB_PASSWORD=xlt_blog

# 上传目录（相对 apps/server 运行目录）
UPLOAD_DIR=uploads

# 初始管理员（仅 seeder 使用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# AI（OpenAI 兼容，如火山方舟 / DeepSeek）
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
