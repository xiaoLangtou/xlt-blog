# =====================================================================
# xlt-blog 生产环境变量（源码构建部署方式）
# 用法:
#   cp deploy/.env.prod.example deploy/.env.prod
#   vi deploy/.env.prod   # 修改下面所有 change_me 项
# =====================================================================

# ===== MySQL（1Panel 外部容器 1Panel-mysql-Blf7）=====
# 数据库名（需已在 1Panel 的 MySQL 中创建）
DB_NAME=xlt_blog
# root 密码（对应连接串 mysql://root:<DB_PASSWORD>@1Panel-mysql-Blf7:3306）
DB_PASSWORD=change_me_db_pwd

# ===== Redis（1Panel 外部容器 1Panel-redis-VR85）=====
# Redis 密码（对应连接串 redis://:<REDIS_PASSWORD>@1Panel-redis-VR85:6379）
REDIS_PASSWORD=change_me_redis_pwd

# ===== 1Panel 网络 =====
# 1Panel 安装时默认创建的 bridge 网络名（应用容器通过它访问 1Panel 的 mysql/redis）
NETWORK_NAME=1panel-network

# ===== 站点 =====
# 对外访问地址（用于 sitemap / SEO），不要带尾斜杠
SITE_URL=http://your-domain-or-ip

# ===== 服务端 =====
PORT=3000
UPLOAD_DIR=uploads
# 初始管理员（仅首次 seed 使用，已存在则跳过）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_pwd

# ===== AI（可选，留空则后台 AI 功能不可用）=====
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
