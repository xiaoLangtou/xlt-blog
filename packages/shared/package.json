{
  "name": "@xlt-blog/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "tiptap": [
        "./dist/tiptap.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tiptap": {
      "import": {
        "types": "./dist/tiptap.d.mts",
        "default": "./dist/tiptap.mjs"
      },
      "require": {
        "types": "./dist/tiptap.d.cts",
        "default": "./dist/tiptap.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/tiptap.ts --dts --format esm,cjs",
    "dev": "tsdown src/index.ts src/tiptap.ts --dts --format esm,cjs --watch"
  },
  "devDependencies": {
    "@types/sanitize-html": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@tiptap/core": "^3.30.1",
    "@tiptap/extension-code-block-lowlight": "^3.30.1",
    "@tiptap/extension-highlight": "^3.30.1",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-task-item": "^3.30.1",
    "@tiptap/extension-task-list": "^3.30.1",
    "@tiptap/extension-text-align": "^3.30.1",
    "@tiptap/extension-underline": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "lowlight": "^3.3.0",
    "sanitize-html": "catalog:"
  }
}
